# Cloudflare Pages headers (ported from vercel.json)
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/favicon.svg
  Cache-Control: public, max-age=86400
